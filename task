import os
from selenium import webdriver
from selenium.webdriver.common.by import By
import time

try:
    link = "http://suninjuly.github.io/file_input.html"
    browser = webdriver.Chrome()
    browser.get(link)

    # Заполняем текстовые поля
    browser.find_element(By.NAME, "firstname").send_keys("Ivan")
    browser.find_element(By.NAME, "lastname").send_keys("Petrov")
    browser.find_element(By.NAME, "email").send_keys("ivan@example.com")

    # Загружаем файл
    current_dir = os.path.abspath(os.path.dirname(__file__))   # папка со скриптом
    file_path = os.path.join(current_dir, "example.txt")       # путь к файлу

    # создаём пустой файл, если его нет
    with open(file_path, "w") as f:
        f.write("")

    browser.find_element(By.CSS_SELECTOR, "input[type='file']").send_keys(file_path)

    # Submit
    browser.find_element(By.CSS_SELECTOR, "button.btn").click()

finally:
    time.sleep(10)
    browser.quit() 
